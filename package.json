{
  "name": "recovery-os",
  "version": "1.0.0",
  "private": true,
  "description": "Closed-loop, policy-gated revenue recovery system for Razorpay Track 3.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "tsx src/ingestion/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "evaluate:prepare": "tsx src/execution/executeOnBatch.ts",
    "evaluate": "tsx src/evaluation/runEvaluation.ts",
    "evaluate:competitive": "tsx src/evaluation/competitiveBenchmark.ts",
    "evaluate:ai": "tsx src/evaluation/aiDecisionBenchmark.ts",
    "evaluate:provider": "tsx src/evaluation/providerReconciliation.ts",
    "test:policy": "tsx src/policy/testPolicyGate.ts",
    "test:verifier": "tsx src/verifier/testVerifier.ts",
    "test:dashboard": "tsx src/dashboard/testDashboard.ts",
    "test:intelligence": "tsx src/intelligence/testPhaseB.ts",
    "test:channels": "tsx src/channels/testChannels.ts",
    "test:benchmark": "tsx src/evaluation/testCompetitiveBenchmark.ts",
    "test:ai": "tsx src/agent/testFinalAi.ts",
    "test:payment-integrity": "tsx src/recovery/testPaymentIntegrity.ts",
    "test:payment-link-provider": "tsx src/execution/testPaymentLinkProvider.ts",
    "test:core": "npm run typecheck && npm run test:policy && npm run test:verifier && npm run test:dashboard && npm run test:intelligence && npm run test:channels && npm run test:benchmark && npm run test:ai && npm run test:payment-integrity && npm run test:payment-link-provider"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "0.24.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "groq-sdk": "1.6.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
