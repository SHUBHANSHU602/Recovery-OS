{
  "name": "recovery-os",
  "version": "1.0.0",
  "private": true,
  "description": "Closed-loop, policy-gated revenue recovery system for Razorpay Track 3.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "tsx src/ingestion/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "evaluate": "tsx src/evaluation/runEvaluation.ts",
    "test:policy": "tsx src/policy/testPolicyGate.ts",
    "test:verifier": "tsx src/verifier/testVerifier.ts",
    "test:core": "npm run typecheck && npm run test:policy && npm run test:verifier"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
